# ==================================================
# GMAIL CONFIGURATION (REQUIRED)
# ==================================================
# Email address for the assistant account
EMAIL=tba.capstoneproject@gmail.com

# Gmail App Password (NOT your regular password)
# Generate at: https://myaccount.google.com/apppasswords
# Select "Mail" and "Windows" to generate a 16-character password
APP_PASSWORD="qbpsubyswkwnuuzc"

# ==================================================
# OLLAMA CONFIGURATION (Optional - defaults provided)
# ==================================================
# URL where Ollama API is running (default: http://localhost:11434/api/generate)
OLLAMA_URL=http://localhost:11434/api/generate

# Model name to use (default: tinyllama)
# Must be installed: ollama pull tinyllama
OLLAMA_MODEL=tinyllama

# ==================================================
# EMAIL PROCESSING (Optional - defaults provided)
# ==================================================
# Maximum number of emails to fetch per run (default: 10)
# EMAIL_FETCH_LIMIT=10

# Request timeout in seconds (default: 60)
# OLLAMA_TIMEOUT=60

# ==================================================
# LOGGING (Optional)
# ==================================================
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO
